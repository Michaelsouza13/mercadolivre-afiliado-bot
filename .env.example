# ==========================================
# CONFIGURACOES OBRIGATORIAS
# ==========================================

# Token do bot do Telegram (criar em @BotFather)
TELEGRAM_BOT_TOKEN=

# ID do grupo/canal do Telegram (numeros negativo tipo -1001234567890)
TELEGRAM_CHAT_ID=

# Tag de afiliado do Mercado Livre
# Descubra sua tag gerando um link no portal de afiliados
# Formato 1 (mais comum - matt tool):  matt:SEU_USERNAME:SEU_TOOLID
# Ex: matt:sami2297242:18952962
# Formato 2 (tag simples):  SEUNOME-20
AFFILIATE_TAG=

# ==========================================
# CONFIGURACOES OPCIONAIS
# ==========================================

# Categoria de produtos para filtrar (deixe vazio para todas)
# Opcoes: celulares, informatica, eletrodomesticos, casa, moda,
#         esportes, ferramentas, brinquedos, supermercado,
#         automotivo, moveis, pet, saude, bebes, eletronicos
# ML_CATEGORY=informatica

# Maximo de ofertas enviadas por execucao (padrao: 5)
# MAX_OFFERS_PER_RUN=5
