# ==========================================
# CONFIGURACOES OBRIGATORIAS
# ==========================================

# Token do bot do Telegram
# Crie um bot em @BotFather no Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=

# ID do grupo/canal do Telegram
# Adicione o bot ao grupo, envie uma mensagem, depois acesse:
# https://api.telegram.org/bot{SEU_TOKEN}/getUpdates
# O chat_id aparece no JSON retornado
TELEGRAM_CHAT_ID=

# Parametro de afiliado do Mercado Livre
# Ex: mch_id=SEU_ID  ou  partner_id=SEU_ID
# Sera adicionado ao final da URL de cada produto
AFFILIATE_PARAM=

# ==========================================
# CONFIGURACOES OPCIONAIS
# ==========================================

# Maximo de ofertas enviadas por execucao (padrao: 5)
# MAX_OFFERS_PER_RUN=5
